{
  "name": "kartotek",
  "version": "0.1.0",
  "private": true,
  "description": "Kartotek: a spaced-repetition and study app (desktop shell)",
  "license": "MIT",
  "author": "Eren",
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "npm --prefix ui ci",
    "start": "node scripts/start.cjs",
    "build:ui": "npm --prefix ui run build",
    "test": "node scripts/run-tests.cjs",
    "smoke": "node scripts/smoke.cjs",
    "icon": "node scripts/make-icon.cjs",
    "hygiene": "node scripts/check-hygiene.cjs",
    "dist": "npm run build:ui && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "pdfjs-dist": "6.5.438"
  }
}
